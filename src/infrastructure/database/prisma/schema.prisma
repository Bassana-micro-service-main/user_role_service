generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model RoleTable {
  id          String   @id @default(uuid())
  public_id   String   @unique
  name        String   @unique
  description String
  is_system   Boolean
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}

