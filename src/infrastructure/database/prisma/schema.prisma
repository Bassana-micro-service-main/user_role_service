generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
 } 

model RoleTable {
  id          String   @id @default(uuid())
  publicId   String   @unique
  name        String   @unique
  description String
  isSystem   Boolean
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
model UserRoleTable {
  id          String   @id @default(uuid())
  publicId   String   @unique
  userId        String   @unique
  roleId String         @unique
  createdAt  DateTime @default(now())
}
