# ===============================
# APP
# ===============================
NODE_ENV=production
APP_NAME=user_role-service
PORT=3000

# ===============================
# DATABASE
# ===============================
DB_HOST=user_role-db-prod
DB_PORT=5432
DB_NAME=user_role-db
DB_USER=postgres
DB_PASSWORD=postgres
POSTGRES_DB=user_role-db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ===============================
# SECURITY / AUTH
# ===============================
JWT_SECRET=super-secret-key
JWT_EXPIRES_IN=1h

# ===============================
# API / GATEWAY
# ===============================
API_PREFIX=/api
API_GATEWAY_URL=http://gateway:3000

# ===============================
# LOGGING
# ===============================
LOG_LEVEL=info

# ===============================
# FEATURE FLAGS
# ===============================
ENABLE_SWAGGER=false

PRISMA_CLIENT_ENGINE_TYPE=binary
